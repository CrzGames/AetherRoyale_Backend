# .env
NODE_ENV=development
# Définir la durée d'expiration des jetons :
# - En jours : "30 days"
# - En heures : "12 hours"
# - En secondes : "3600"
API_USER_TOKEN_EXPIRATION="1 days"
API_USER_TOKEN_SECRET_LENGTH=128
HASH_DRIVER=argon
TZ=UTC
PORT=3400
HOST=0.0.0.0
LOG_LEVEL=trace
