S3_BUCKET_OVH_REGION=de
S3_BUCKET_OVH_NAME=aetherroyale-s3
S3_BUCKET_OVH_VISIBILITY=private
S3_BUCKET_OVH_ENDPOINT=https://s3.de.io.cloud.ovh.net/
S3_BUCKET_OVH_LIST_FILES_GAMECLIENT_AETHER_ROYALE=gameclient-aetherroyale/binaries/ # Préfixe pour lister les fichiers de builds de clients de jeu dans le bucket OVH
