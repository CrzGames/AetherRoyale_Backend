CRYPT_PUBLIC_KEY="024d633d774005d2d84fc8a1df758b512a24877d6ac2983b1ecfb5df53d41e2a99"

# .env
NODE_ENV=development
# Définir la durée d'expiration des jetons :
# - En jours : "30 days"
# - En heures : "12 hours"
# - En secondes : "3600"
API_USER_TOKEN_EXPIRATION="1 days"
API_USER_TOKEN_SECRET_LENGTH=128
HASH_DRIVER=argon
TZ=UTC
PORT=3400
HOST=0.0.0.0
LOG_LEVEL=debug
APP_KEY=2xbvu-EZ5g8viOREwy-MLmijeQEklsCB
DB_HOST=host.docker.internal
DB_PORT=3307
DB_USER=testuser
DB_PASSWORD=testpassword
DB_DATABASE_NAME=aetherroyale_develop
DB_CONNECTION=mysql
DB_DEBUG=true
# Authentification via Header pour les requêtes API qui souhaite accéder à la route /health
HEALTH_API_KEY_SECRET=toto
# Endpoint gRPC Agones Allocator (IN-CLUSTER)
AGONES_ALLOCATOR_ENDPOINT_GRPC=agones-allocator.agones-system.svc.cluster.local:443
# Namespace Kubernetes où vivent les Fleets/GameServers
AGONES_GAMESERVERS_NAMESPACE=gameservers
# Nom de la Fleet Agones exact, ciblée pour l'allocation
AGONES_FLEET_NAME=fleet-aetherroyale-game-server
# DNS Quilkin (UDP) pour les GameServers Agones
QUILKIN_DNS=staging.quilkin.aetherroyale.crzgames.com
# Port de communication UDP pour les GameServers Agones
QUILKIN_PORT=7777
# Variables pour la configuration du package drive avec OVH Object Storage (compatible S3)
DRIVE_DISK=s3
S3_BUCKET_OVH_ACCESS_KEY_ID=e7b30359e94041aaa203f8df25c6a968
S3_BUCKET_OVH_SECRET_ACCESS_KEY=dba640aeca52461e8bdd684330729e3f
S3_BUCKET_OVH_REGION=de
S3_BUCKET_OVH_NAME=aetherroyale-s3
S3_BUCKET_OVH_VISIBILITY=private
S3_BUCKET_OVH_ENDPOINT=https://s3.de.io.cloud.ovh.net/
S3_BUCKET_OVH_LIST_FILES_GAMECLIENT_AETHER_ROYALE=clients/staging/ # Préfixe pour lister les fichiers de builds de clients de jeu dans le bucket OVH
S3_BUCKET_OVH_SIGNED_URL_EXPIRES_SECONDS=1800 # 30 minutes
REDIS_HOST=host.docker.internal
REDIS_PORT=6379
REDIS_PASSWORD=