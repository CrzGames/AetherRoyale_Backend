CRYPT_PUBLIC_KEY_PRODUCTION="03b018237550077e10f9a2b480c7e897a8a94fd61efbb89e84cbfa6d5326c72d41"

# .env.production
NODE_ENV=production
# Définir la durée d'expiration des jetons :
# - En jours : "30 days"
# - En heures : "12 hours"
# - En secondes : "3600"
API_USER_TOKEN_EXPIRATION="1 days"
API_USER_TOKEN_SECRET_LENGTH=128
HASH_DRIVER=argon
TZ=UTC
PORT=3333
HOST=0.0.0.0
LOG_LEVEL=trace
APP_KEY=2xbvu-EZ5g8viOREwy-MLmijeQEklsCB
# DB_HOST = le nom de service Kubernetes du pod MariaDB dans le namespace staging-db (IN-CLUSTER)
DB_HOST=mariadb.prod-db.svc.cluster.local
DB_PORT=3306
DB_USER=testuser
DB_PASSWORD=testpassword
DB_DATABASE_NAME=aetherroyale_production
DB_CONNECTION=mysql
DB_DEBUG=true
# Authentification via Header pour les requêtes API qui souhaite accéder à la route /health
HEALTH_API_KEY_SECRET=toto
# Endpoint gRPC Agones Allocator (IN-CLUSTER)
AGONES_ALLOCATOR_ENDPOINT_GRPC=agones-allocator.agones-system.svc.cluster.local:443
# Namespace Kubernetes où vivent les Fleets/GameServers
AGONES_GAMESERVERS_NAMESPACE=gameservers
# Nom de la Fleet Agones exact, ciblée pour l'allocation
AGONES_FLEET_NAME=fleet-aetherroyale-game-server
# DNS Quilkin (UDP) pour les GameServers Agones
QUILKIN_DNS=quilkin.aetherroyale.crzgames.com
# Port de communication UDP pour les GameServers Agones
QUILKIN_PORT=7777
# Variables pour la configuration du package drive avec OVH Object Storage (compatible S3)
DRIVE_DISK=s3
S3_BUCKET_OVH_ACCESS_KEY_ID=e7b30359e94041aaa203f8df25c6a968
